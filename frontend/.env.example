# Google OAuth client IDs (https://console.cloud.google.com/apis/credentials)
# Create an "iOS" client (bundle id of your dev build), an "Android" client
# (package name + SHA-1), and a "Web application" client. The web client id is
# also used for the Expo Go proxy flow. Restart the dev server after editing:
# npx expo start -c
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Apple Sign in with Apple needs no in-app key. For standalone builds it needs:
# - app.json: ios.usesAppleSignIn + expo-apple-authentication plugin (already set)
# - the Sign In with Apple capability on your Apple Developer bundle id.

# Co-operative rates & tiers — change these and every screen follows.
# (defaults shown; all figures are plain numbers, no commas/currency symbols)
# Restart the dev server after editing: npx expo start -c
EXPO_PUBLIC_EMERGENCY_LOAN_APR=5
EXPO_PUBLIC_BUSINESS_LOAN_APR=10
EXPO_PUBLIC_HEADLINE_LOAN_MAX=500000
EXPO_PUBLIC_EMERGENCY_LOAN_MAX=200000
EXPO_PUBLIC_BUSINESS_LOAN_MAX=1000000
EXPO_PUBLIC_WEEKLY_CONTRIBUTION=5000
EXPO_PUBLIC_MONTHLY_CONTRIBUTION=20000
